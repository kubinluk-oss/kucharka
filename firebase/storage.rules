rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isImage() {
      return request.resource.size < 8 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    function isGroupMember(gid) {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.uid in firestore.get(/databases/(default)/documents/groups/$(gid)).data.members;
    }

    // fotky receptů skupiny: číst i nahrávat smí jen členové
    match /groups/{gid}/photos/{file} {
      allow read: if isGroupMember(gid);
      allow create, update: if isGroupMember(gid) && isImage();
      allow delete: if isGroupMember(gid);
    }

    // profilové fotky: jedna na účet, zapisuje jen vlastník
    match /avatars/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && file == request.auth.uid + '.jpg' && isImage();
      allow delete: if request.auth != null && file == request.auth.uid + '.jpg';
    }

    // fotky z původní společné kuchařky — jen ke čtení
    match /photos/{file} {
      allow read: if request.auth != null;
    }
  }
}
